# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=job_matching

# Email delivery (Gmail requires a Google App Password, not your account password)
# Copy this file to backend/.env and replace the placeholders.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-character-google-app-password
# Supported user aliases: SMTP_USER, GMAIL_USER
# Supported password aliases: EMAIL_PASS, SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Authentication
# Generate a unique random secret of at least 32 characters for each deployment.
JWT_SECRET=

# AI Keys (Optional: Provide at least one for advanced AI evaluation)
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_CV_MODEL=gemini-2.5-flash
GEMINI_MATCHING_MODEL=gemini-2.5-flash
OPENAI_CV_MODEL=gpt-4o-mini

# Optional candidate application status webhook (for SMS/Telegram integrations)
APPLICATION_STATUS_WEBHOOK_URL=
APPLICATION_STATUS_WEBHOOK_SECRET=

# Outbound SMS. Configure Twilio credentials server-side to enable real delivery.
# SMS_PROVIDER=mock is accepted only in NODE_ENV=test and is recorded as SIMULATED.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram bot alerts and public channel broadcasts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
# Optional explicit owner identity for Telegram /start and /admin SSO.
# If omitted, TELEGRAM_ADMIN_CHAT_ID is used (the configured owner default is 6707730892).
TELEGRAM_SUPER_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_EMAIL=
# Required for application/status alert copies when the intended user has no valid linked Telegram chat.
# Configure this to the verified Bot Owner's private numeric chat ID; admin alerts never use groups/channels.
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_STATS_HOUR=8
# Add the bot as a channel administrator with permission to post messages.
# TELEGRAM_CHANNEL is the preferred alias; the PUBLIC_CHANNEL and CHANNEL_ID
# names remain supported for existing deployments.
TELEGRAM_CHANNEL=@yabsira_tech_jobs
TELEGRAM_CHANNEL_ID=
TELEGRAM_PUBLIC_CHANNEL=@yabsira_tech_jobs
# The server registers this webhook at startup when the bot settings are configured.
# Endpoint: /api/telegram/webhook. Use the same secret_token when configuring Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Development defaults to the Vite website. Set APP_URL to your live website origin in production.
APP_URL=http://localhost:5173
# Set this to a public, externally accessible origin for Telegram channel web buttons.
# Do not use authenticated ais-dev-*.run.app preview hosts.
# Telegram notification buttons use APP_URL. Set BotFather's Main Mini App URL to the same origin.
TELEGRAM_PUBLIC_APP_URL=
# Channel job links use startapp=job_ID and require that Main Mini App configuration.
# Optional legacy alias; APP_URL takes precedence for backend links.
PUBLIC_APP_URL=
